# Preserve the reviewed upstream bytes and deterministic build output on Windows.
vendor/** -text
fonts/** -text
runtime/** -text
local/** text eol=lf
*.mjs text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
