FROM python:3.12.14-slim
WORKDIR /app
COPY pyproject.toml uv.lock /app/
COPY services/telemetry/src /app/services/telemetry/src
COPY services/common/src /app/services/common/src
COPY scripts/host-metrics.py /app/scripts/host-metrics.py
ENV PYTHONPATH=/app/services/common/src:/app/services/telemetry/src
ENV PATH=/app/.venv/bin:$PATH
RUN apt-get update \
    && apt-get upgrade --no-install-recommends -y \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.8.0 \
    && uv sync --frozen --no-dev --no-install-project \
    && rm -rf /root/.cache
