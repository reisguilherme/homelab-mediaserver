# Generated by HomeServer; edit the operator .env instead.
[Unit]
Description=HomeServer host and capacity snapshots
After=local-fs.target

[Service]
Type=simple
ExecStart="/opt/homeserver/current/.venv/bin/python" "/opt/homeserver/current/scripts/host-metrics.py" --env-file "/etc/homeserver/server.env" --loop
Group=1000
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
