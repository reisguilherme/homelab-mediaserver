# Generated by HomeServer; edit the operator .env instead.
[Unit]
Description=HomeServer guarded stack supervisor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor="/srv/data"

[Service]
Type=simple
ExecStart="/opt/homeserver/current/.venv/bin/python" "/opt/homeserver/current/scripts/supervise-stack.py" --env-file "/etc/homeserver/server.env"
Restart=on-failure
RestartSec=10s
TimeoutStopSec=120s
UMask=0027

[Install]
WantedBy=multi-user.target
