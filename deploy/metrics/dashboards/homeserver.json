          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Envelopes válidos",
      "description": "JSON, estrutura da fonte e timestamp aceitos. Não garante valores válidos de cada sensor ou pool; estes são validados individualmente. O envelope pode estar atrasado: conferir freshness.",
      "gridPos": { "x": 6, "y": 3, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "homelab-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "homeserver_snapshot_valid{job=\"homeserver\"}",
          "legendFormat": "{{source}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Sem dados",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Ausente ou inválido", "color": "red" },
                "1": { "text": "Envelope válido", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["last"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU e memória",
      "description": "Percentuais reportados pelo snapshot de host. Ausência de amostra não significa consumo zero.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
