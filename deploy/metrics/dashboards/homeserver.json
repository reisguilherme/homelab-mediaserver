{
  "uid": "homeserver-overview",
  "title": "HomeServer • host, rede e pools",
  "description": "Visão privada de snapshots sanitizados; estado desconhecido não é zero saudável.",
  "tags": [
    "homeserver",
    "snapshots"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "HomeServer • evidências locais",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Host: válido por **90 s**. Capacidade: válida por **30 s**, com validação por pool. Coleta a cada **15 s**. “Sem dados” indica evidência ausente ou inválida; lacunas não são preenchidas. A saúde do exporter não comprova a saúde do servidor. Alertas e publicação dos snapshots ainda exigem configuração."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Exporter acessível",
      "description": "Resultado da coleta Prometheus; não representa saúde dos snapshots.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"homeserver\"}",
          "legendFormat": "Coleta",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Acessível",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Snapshots frescos",
      "description": "1 = fresco e válido; 0 = ausente, inválido ou atrasado. Falha de coleta aparece como Sem dados.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homeserver_snapshot_fresh{job=\"homeserver\"}",
          "legendFormat": "{{source}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sem evidência fresca",
                  "color": "red"
                },
                "1": {
                  "text": "Fresco",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Idade dos snapshots",
      "description": "Só existe quando o timestamp é válido. Host: até 90 s; capacidade: até 30 s.",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homeserver_snapshot_age_seconds{job=\"homeserver\"}",
          "legendFormat": "{{source}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
