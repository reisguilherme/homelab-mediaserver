{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "git_commit", "database_schema", "database_compatibility", "config_version", "requires_backup", "images", "image_references", "config_checksums", "artifact_sha256", "tools"],
  "properties": {
    "schema_version": {"const": 2},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "database_schema": {"type": "integer", "minimum": 1},
    "requires_backup": {"type": "boolean"},
    "images": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "config_checksums": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "image_references": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}},
    "database_compatibility": {"type": "object", "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0}, "maximum": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "config_version": {"type": "integer", "minimum": 1},
    "tools": {"type": "object"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
