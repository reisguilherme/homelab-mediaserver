COMPOSE_PROJECT_NAME=homeserver-dev
HOMESERVER_RUNTIME=.runtime/dev
HOMESERVER_MEDIA_ROOT=.runtime/dev/data
HOMESERVER_APPDATA_ROOT=.runtime/dev/appdata
HOMESERVER_TRANSCODE_ROOT=.runtime/dev/transcode
HOMESERVER_MQTT_PASSWD=.runtime/dev/mosquitto/passwd
HOMESERVER_ADMIN_TOKEN=replace-with-dev-admin-token
HOMESERVER_CSRF_TOKEN=replace-with-dev-csrf-token
HOMESERVER_COLLECTOR_TOKEN=replace-with-dev-collector-token
HOMESERVER_MQTT_PORT=18883
HOMESERVER_CONTROL_PORT=18080
HOMESERVER_TELEMETRY_PORT=18081
HOMESERVER_DEV_TOKEN=replace-with-local-only-token
