# HomeServer — preferências e credenciais da instalação pessoal.
# Copie para .env, preencha as credenciais e ajuste suas preferências.
# Caminhos, portas e URLs internas ficam definidos no código/Compose.
# Nunca envie o .env preenchido para o Git.

# Preferências gerais
HOMESERVER_TIMEZONE="America/Sao_Paulo"
HOMESERVER_TRANSCODE_THREADS="0"
HOMESERVER_JELLYFIN_ENABLE_MEDIA_DELETION=""

# Downloads, conexões e seeding
HOMESERVER_DOWNLOAD_MAX_ACTIVE="10"
HOMESERVER_TORRENT_MAX_CONNECTIONS="500"
HOMESERVER_TORRENT_MAX_CONNECTIONS_PER_TORRENT="100"
HOMESERVER_UPLOAD_SLOTS="20"
HOMESERVER_UPLOAD_SLOTS_PER_TORRENT="4"
HOMESERVER_SEED_MAX_ACTIVE="-1"
HOMESERVER_TORRENT_MAX_ACTIVE="-1"
HOMESERVER_QUEUE_IGNORE_SLOW_TORRENTS="false"
HOMESERVER_UPLOAD_LIMIT_MBIT="20"
HOMESERVER_DOWNLOAD_LIMIT_MBIT="0"
HOMESERVER_SEED_RATIO_LIMIT="-1"
HOMESERVER_SEED_TIME_LIMIT_MINUTES="-1"
HOMESERVER_SEED_INACTIVE_LIMIT_MINUTES="-1"
HOMESERVER_SERIES_DOWNLOAD_WINDOW="10"

# Seleção de fontes e recuperação de downloads
HOMESERVER_SERIES_PREFER_SEASON_PACK="true"
HOMESERVER_SERIES_RELEASE_AFFINITY="true"
HOMESERVER_RELEASE_INDEXER_PRIORITY="uindex,1337x"
HOMESERVER_INDEXER_FALLBACK_MIN_SEEDERS="5"
HOMESERVER_MOVIE_INDEXER_FALLBACK_MIN_SEEDERS="20"
HOMESERVER_WORKER_INTERVAL_SECONDS="5"
HOMESERVER_SEARCH_RETRY_SECONDS="300"
HOMESERVER_SOURCE_STALL_SECONDS="300"
HOMESERVER_SOURCE_SLOW_WINDOW_SECONDS="300"
HOMESERVER_SOURCE_SEARCH_RETRY_SECONDS="300"
HOMESERVER_SOURCE_PROBE_SECONDS="60"
HOMESERVER_SOURCE_MIN_RATE_KIB="1024"
HOMESERVER_SOURCE_MIN_TIME_GAIN_PERCENT="20"
HOMESERVER_SOURCE_PROBE_ENABLED="true"
HOMESERVER_SOURCE_SLOW_REPLACEMENT_ENABLED="false"

# Qualidade e áudio — listas em ordem de preferência
HOMESERVER_MOVIE_RESOLUTIONS="2160,1080"
HOMESERVER_SERIES_RESOLUTIONS="1080"
HOMESERVER_MEDIA_SOURCES="remux,bluray,webdl"
HOMESERVER_PREFER_DOLBY_VISION="true"
HOMESERVER_PREFER_ATMOS="true"
HOMESERVER_QUALITY_MIN_MIB_PER_MIN_720="10"
HOMESERVER_QUALITY_MIN_MIB_PER_MIN_1080="20"
HOMESERVER_QUALITY_MIN_MIB_PER_MIN_2160="50"
HOMESERVER_AUTOMATIC_UPGRADES="false"
HOMESERVER_AUDIO_LANGUAGES="original"

# Legendas — pt-BR antes de en-US
HOMESERVER_SUBTITLE_LANGUAGES="pt-BR,en-US"
HOMESERVER_SUBTITLE_MATCH_MODES="release,compatible_edition"
HOMESERVER_SUBTITLE_SKIP_ORIGINAL_AUDIO_LANGUAGES="pt-BR"
HOMESERVER_SUBTITLE_ALLOW_GENERIC_ENGLISH="true"
HOMESERVER_SUBTITLE_CREDITS_MARGIN_SECONDS="600"
HOMESERVER_SUBTITLE_PROVIDERS="bazarr,subdl"
HOMESERVER_BAZARR_PROVIDERS="subdl,opensubtitlescom"

# Indexadores e Cloudflare
HOMESERVER_PROWLARR_INDEXERS="[]"
HOMESERVER_BYPARR_ENABLED="false"

# Monitoramento e logs
HOMESERVER_METRICS_INTERVAL_SECONDS="5"
HOMESERVER_METRICS_MAX_AGE_SECONDS="90"
HOMESERVER_LOG_LEVEL="INFO"
HOMESERVER_LOG_MAX_SIZE_MB="10"
HOMESERVER_LOG_MAX_FILES="3"
HOMESERVER_ALERTS_ENABLED="false"
HOMESERVER_ALERT_RETRY_SECONDS="60"

# Credenciais — Jellyfin/Seerr podem ficar vazios até o primeiro setup
HOMESERVER_JELLYFIN_API_KEY=""
HOMESERVER_SEERR_API_KEY=""
HOMESERVER_SONARR_API_KEY=""
HOMESERVER_RADARR_API_KEY=""
HOMESERVER_PROWLARR_API_KEY=""
HOMESERVER_BAZARR_API_KEY=""
HOMESERVER_SUBDL_API_KEY=""
HOMESERVER_OPENSUBTITLES_USERNAME=""
HOMESERVER_OPENSUBTITLES_PASSWORD=""
HOMESERVER_ARR_TOKEN=""
HOMESERVER_ADMIN_TOKEN=""
HOMESERVER_CSRF_TOKEN=""
HOMESERVER_ADMIN_PASSWORD=""
HOMESERVER_QBIT_PASSWORD=""
HOMESERVER_ADMIN_USERNAME="root"
HOMESERVER_QBIT_USERNAME="root"
HOMESERVER_ALERT_WEBHOOK_URL=""
